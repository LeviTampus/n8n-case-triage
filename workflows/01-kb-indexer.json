{
  "name": "01 \u00b7 KB Indexer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 2
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -784,
        -32
      ],
      "id": "909e2475-3239-4115-98ff-655c04e5ac1e",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "resource": "search",
