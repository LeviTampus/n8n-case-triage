{
  "name": "03 - Triage Error Handler",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "dd7268ef-8674-4574-b36b-3031701736b7",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "tableId": "failed_cases",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "error",
              "fieldValue": "={{ $json.execution.error.message }}"
            },
            {
              "fieldId": "payload",
              "fieldValue": "={{ JSON.stringify($json) }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "id": "98fe0d8f-c270-42bc-8ab5-bea0b6810097",
      "name": "Create a row"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "YOUR_SLACK_CHANNEL_ID",
          "mode": "list",
          "cachedResultName": "your-channel"
        },
        "text": "=:x: *Triage workflow failed* \n*Workflow:* {{ $json.workflow.name }} \n*Node:* {{ $json.execution.lastNodeExecuted }} \n*Error:* {{ $json.execution.error.message }}",
        "otherOptions": {}
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        448,
        0
      ],
      "id": "9b4a3735-50d6-4989-b27f-cfef5f6e796c",
      "name": "Send a message"
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Create a row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create a row": {
      "main": [
        [
          {
            "node": "Send a message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
