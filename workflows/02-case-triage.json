      "id": "bd818454-f5f3-4519-b1d7-9f873e64195a",
      "name": "Salesforce Trigger",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "case",
        "operation": "get",
        "caseId": "={{ $json.Id }}"
      },
      "type": "n8n-nodes-base.salesforce",
      "typeVersion": 1.1,
      "position": [
        -320,
        -224
      ],
      "id": "066a7436-b3a9-4921-b88c-74e75c5f65b4",
      "name": "Get a case",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Case Number: {{ $json.CaseNumber }}\nSubject: {{ $json.Subject }}\nDescription: {{ $json.Description }}\nCurrent Priority: {{ $json.Priority }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a support triage assistant for a SaaS support team. Given a new\nSalesforce case, produce a triage decision.\n\nFor each case, decide:\n1. Category \u2014 exactly one of: Billing, Technical, Account, Other.\n2. Priority \u2014 exactly one of: Low, Medium, High, Critical.\n3. Confidence \u2014 a number from 0 to 1: how certain you are of this decision.\n4. Queue \u2014 the destination queue: Billing, Technical, Account, or General.\n5. suggested_reply \u2014 a short, friendly first response a human agent can send.\n\nRules:\n- Always check the Knowledge Base tool for relevant policies or known issues\n  before writing the reply.\n- Base suggested_reply on what the Knowledge Base returns. Never invent product\n  details, prices, timelines, or policies.\n- If the Knowledge Base has nothing relevant, keep the reply generic and lower\n  your confidence.\n- Lower confidence (below 0.7) whenever the case is ambiguous or you are unsure.\n- Use High or Critical only for urgent, blocking, or account-threatening issues.\n- Output only the structured result."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -400,
        208
      ],
      "id": "a77e36d5-94d3-4c88-9456-744c69966912",
      "name": "AI Agent",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Searches the internal Support Knowledge Base (Confluence) for documented\nanswers. The KB covers four areas: Billing & Refunds, Account & Login,\nTechnical Troubleshooting, and Shipping & Delivery.\n\nCall this tool whenever a case mentions a product behavior, policy, error,\nor customer question that likely has a documented answer \u2014 and always before\ndrafting a suggested reply, so the response is grounded in the KB rather\nthan invented.\n\nReturns the most relevant KB passages for the query. Use only what it\nreturns; if the KB has no relevant passage, say so instead of guessing.",
        "tableName": {
          "__rl": true,
          "value": "kb_documents",
          "mode": "list",
          "cachedResultName": "kb_documents"
        },
        "options": {
          "queryName": "match_documents"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [
        -408,
        440
      ],
      "id": "842766df-cdb3-4476-b257-f770c99613d7",
      "name": "Supabase Vector Store"
    },
    {
      "parameters": {
